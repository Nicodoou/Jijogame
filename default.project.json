{
  "name": "Rally",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "shared": {
        "$path": "src/shared"
      },
      "app": {
        "$path": "src/app/shared"
      },
      "vehicle": {
        "$className": "Folder",
        "core": {
          "$path": "src/vehicle/core"
        },
        "shared": {
          "$path": "src/vehicle/shared"
        }
      },
      "input": {
        "$className": "Folder",
        "core": {
          "$path": "src/input/core"
        }
      },
      "camera": {
        "$className": "Folder",
        "core": {
          "$path": "src/camera/core"
        }
      },
      "world": {
        "$className": "Folder",
        "core": {
          "$path": "src/world/core"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "app": {
        "$path": "src/app/server"
      },
      "vehicle": {
        "$path": "src/vehicle/server"
      },
      "world": {
        "$path": "src/world/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "app": {
          "$path": "src/app/client"
        },
        "vehicle": {
          "$path": "src/vehicle/client"
        },
        "input": {
          "$path": "src/input/client"
        },
        "camera": {
          "$path": "src/camera/client"
        },
        "world": {
          "$path": "src/world/client"
        }
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "PhysicsSteppingMethod": "Fixed"
      }
    }
  }
}
