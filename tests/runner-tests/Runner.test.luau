--!strict
local Runner = require("../Runner")

local function createCapturedSuite(): (Runner.Suite, { string })
	local lines: { string } = {}
	local suite = Runner.createSuite(function(line: string)
		table.insert(lines, line)
	end)
	return suite, lines
end

local function runSingleTest(body: (suite: Runner.Suite) -> ()): { string }
	local suite, lines = createCapturedSuite()
	suite.test("inner", function()
		body(suite)
	end)
	return lines
end

Runner.test("a passing test reports nothing", function()
	local lines = runSingleTest(function(suite)
		suite.expectEqual(1, 1)
	end)
	Runner.expectEqual(#lines, 0)
end)

Runner.test("expectEqual failure reports test name, expected and obtained", function()
	local lines = runSingleTest(function(suite)
		suite.expectEqual(2, 3)
	end)
	Runner.expectEqual(#lines, 1)
	Runner.expectEqual(lines[1], "FALLA inner: se esperaba 3 y se obtuvo 2")
end)

Runner.test("expectEqual distinguishes a string from a number", function()
	local lines = runSingleTest(function(suite)
		suite.expectEqual("1", 1)
	end)
	Runner.expectEqual(#lines, 1)
end)

Runner.test("expectEqual treats nan as different from nan", function()
	local lines = runSingleTest(function(suite)
		suite.expectEqual(0 / 0, 0 / 0)
	end)
	Runner.expectEqual(#lines, 1)
end)

Runner.test("expectNear accepts a difference inside the tolerance", function()
	local lines = runSingleTest(function(suite)
		suite.expectNear(1.05, 1, 0.1)
	end)
	Runner.expectEqual(#lines, 0)
end)

Runner.test("expectNear accepts a difference exactly equal to the tolerance", function()
	local lines = runSingleTest(function(suite)
		suite.expectNear(1.5, 1, 0.5)
	end)
	Runner.expectEqual(#lines, 0)
end)

Runner.test("expectNear rejects a difference just over the tolerance", function()
	local lines = runSingleTest(function(suite)
		suite.expectNear(1.5, 1, 0.25)
	end)
	Runner.expectEqual(#lines, 1)
	Runner.expectEqual(string.find(lines[1], "FALLA inner: se esperaba 1", 1, true), 1)
end)

Runner.test("expectNear rejects nan", function()
	local lines = runSingleTest(function(suite)
		suite.expectNear(0 / 0, 1, 1e9)
	end)
	Runner.expectEqual(#lines, 1)
end)

Runner.test("expectError accepts a function that errors", function()
	local lines = runSingleTest(function(suite)
		suite.expectError(function()
			error("boom")
		end)
	end)
	Runner.expectEqual(#lines, 0)
end)

Runner.test("expectError rejects a function that does not error", function()
	local lines = runSingleTest(function(suite)
		suite.expectError(function() end)
	end)
	Runner.expectEqual(#lines, 1)
end)

Runner.test("a test that raises an unexpected error is a failure with its message", function()
	local lines = runSingleTest(function()
		error("unexpected", 0)
	end)
	Runner.expectEqual(lines[1], "FALLA inner: unexpected")
end)

Runner.test("a failing test does not stop the following tests", function()
	local suite, lines = createCapturedSuite()
	suite.test("first", function()
		suite.expectEqual(1, 2)
	end)
	suite.test("second", function()
		suite.expectEqual(1, 1)
	end)
	Runner.expectError(function()
		suite.finish()
	end)
	Runner.expectEqual(lines[#lines], "RESUMEN: 1 OK, 1 con falla, 2 pruebas")
end)

Runner.test("finish does not raise when everything passed", function()
	local suite, lines = createCapturedSuite()
	suite.test("only", function()
		suite.expectEqual(1, 1)
	end)
	suite.finish()
	Runner.expectEqual(lines[1], "RESUMEN: 1 OK, 0 con falla, 1 pruebas")
end)

Runner.test("finish raises when a test failed", function()
	local suite = createCapturedSuite()
	suite.test("broken", function()
		suite.expectEqual(1, 2)
	end)
	Runner.expectError(function()
		suite.finish()
	end)
end)

Runner.test("finish with no tests does not raise", function()
	local suite = createCapturedSuite()
	suite.finish()
end)

Runner.finish()
